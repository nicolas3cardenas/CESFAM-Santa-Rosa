# Copie este archivo como ".env" y complete los valores. El archivo ".env" NO se sube a GitHub.

# --- Servidor -------------------------------------------------------------
PORT=3001
# Dirección del frontend (React). Se usa para el CORS y para armar el enlace de recuperación.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Base de datos --------------------------------------------------------
# Conexión de la APLICACIÓN: usuario con privilegio mínimo (cesfam_api).
DATABASE_URL=postgres://cesfam_api:CAMBIAR_CLAVE_API@localhost:5432/cesfam_santa_rosa
# Conexión de ADMINISTRADOR: solo la usan "npm run db:crear" y las pruebas para crear tablas.
DATABASE_ADMIN_URL=postgres://postgres:SU_CLAVE_DE_POSTGRES@localhost:5432/cesfam_santa_rosa
# Clave que tendrá el usuario cesfam_api (debe ser la misma que puso en DATABASE_URL).
API_DB_PASSWORD=CAMBIAR_CLAVE_API

# Base separada para las pruebas automáticas. El nombre DEBE terminar en _test:
# las pruebas se niegan a correr contra cualquier otra base (borran y recrean las tablas).
TEST_DATABASE_URL=postgres://cesfam_api:CAMBIAR_CLAVE_API@localhost:5432/cesfam_santa_rosa_test
TEST_DATABASE_ADMIN_URL=postgres://postgres:SU_CLAVE_DE_POSTGRES@localhost:5432/cesfam_santa_rosa_test

# --- Seguridad ------------------------------------------------------------
# Texto largo y aleatorio (mínimo 32 caracteres). Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Minutos de inactividad antes de que venza la sesión (informe: 30)
SESION_MINUTOS=30
# Duración máxima de una sesión aunque haya actividad
SESION_MAX_HORAS=8
# Costo del cifrado de contraseñas (bcrypt). 10 a 12 en uso normal.
BCRYPT_RONDAS=10
# Solicitudes permitidas por IP cada 15 minutos en inicio de sesión y recuperación
LIMITE_AUTENTICACION=30

# --- Correo ---------------------------------------------------------------
# "consola": el enlace de recuperación se escribe en la consola del servidor (modo de desarrollo).
# Enviar correos reales queda pendiente hasta definir el servidor de correo del CESFAM.
MODO_CORREO=consola
