{
  "name": "cesfam-santa-rosa-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API del sistema de metas sanitarias del CESFAM Santa Rosa (Express + PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:crear": "node scripts/crear_bd.js",
    "db:crear:test": "node scripts/crear_bd.js --test",
    "rem:demo": "node scripts/generar_rem_demo.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:integracion": "jest --runInBand test/integracion",
    "test:cobertura": "jest --runInBand --coverage --json --outputFile=resultados/jest.json",
    "informe": "node scripts/informe_pruebas.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "jszip": "^3.10.1"
  }
}
